FLASK_ENV=development
SECRET_KEY=replace-with-strong-random-secret
JWT_SECRET_KEY=replace-with-another-strong-random-secret
MONGO_URI=mongodb://localhost:27017/ai_assistant
MONGO_DB_NAME=ai_assistant
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=20
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
APP_RESET_URL=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000
